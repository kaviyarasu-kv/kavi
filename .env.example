# Required for real Gemini generation.
# Add your own API key in a local .env file before running the app.
GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini models. You can change these without editing Python code.
WORKOUT_MODEL=gemini-3.8-flash
NUTRITION_MODEL=gemini-3.8-flash

# SQLite database
DATABASE_URL=sqlite:///./fitbuddy.db

# Optional: if set, /view-all-users requires ?admin_token=YOUR_VALUE
ADMIN_TOKEN=change-me

# Maximum feedback characters
MAX_FEEDBACK_LENGTH=2000